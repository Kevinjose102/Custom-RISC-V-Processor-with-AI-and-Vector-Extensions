+class ProfileCollector:
+    """Low-overhead wall-clock profiler for the KV260 PS/PL inference pipeline."""
+    def __init__(self, enabled=False):
+        self.enabled = bool(enabled)
+        self.aggregate = defaultdict(lambda: {"seconds": 0.0, "count": 0, "bytes": 0})
+        self.layers = defaultdict(lambda: defaultdict(lambda: {"seconds": 0.0, "count": 0, "bytes": 0}))
+        self.frames = []
+        self.current_frame = None
+        self.video_meta = {}
+        self.result = {}
+
+    @staticmethod
+    def now_ns():
+        return time.perf_counter_ns()
+
+    def add(self, metric, seconds, count=1, bytes_count=0, layer=None):
+        if not self.enabled:
+            return
+        seconds = float(max(0.0, seconds))
+        rec = self.aggregate[metric]
+        rec["seconds"] += seconds
+        rec["count"] += int(count)
+        rec["bytes"] += int(bytes_count)
+        if layer is not None:
+            lrec = self.layers[str(layer)][metric]
+            lrec["seconds"] += seconds
+            lrec["count"] += int(count)
+            lrec["bytes"] += int(bytes_count)
+
+    def add_ns(self, metric, start_ns, end_ns=None, count=1, bytes_count=0, layer=None):
+        if not self.enabled:
+            return
+        if end_ns is None:
+            end_ns = self.now_ns()
+        self.add(metric, (end_ns - start_ns) / 1e9, count=count, bytes_count=bytes_count, layer=layer)
+
+    def total(self, metric, layer=None):
+        if layer is None:
+            return float(self.aggregate.get(metric, {}).get("seconds", 0.0))
+        return float(self.layers.get(str(layer), {}).get(metric, {}).get("seconds", 0.0))
+
+    def record_frame(self, slot, source_index, decode_s, spatial_s, ok=True, breakdown=None):
+        if not self.enabled:
+            return
+        rec = {
+            "slot": int(slot),
+            "source_frame": int(source_index),
+            "decoded": bool(ok),
+            "decode_s": float(decode_s),
+            "spatial_s": float(spatial_s),
+            "frame_total_s": float(decode_s + spatial_s),
+        }
+        if breakdown:
+            for k, v in breakdown.items():
+                rec[f"{k}_s"] = float(v)
+        self.frames.append(rec)
+
+    @staticmethod
+    def _fmt_ms(seconds):
+        return f"{seconds * 1e3:10.3f}"
+
+    @staticmethod
+    def _percentile(values, q):
+        return float(np.percentile(np.asarray(values, dtype=np.float64), q)) if values else 0.0
+
+    def _bandwidth_mibs(self, rec):
+        sec = float(rec.get("seconds", 0.0))
+        return (float(rec.get("bytes", 0)) / (1024.0 * 1024.0) / sec) if sec > 0 else 0.0
+
