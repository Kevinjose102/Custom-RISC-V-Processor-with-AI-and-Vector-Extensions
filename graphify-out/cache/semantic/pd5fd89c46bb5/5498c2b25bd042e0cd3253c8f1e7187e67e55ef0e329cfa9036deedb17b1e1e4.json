{"nodes": [{"id": "c_class_src_obsolete_m_ext_multiplier_designs_report", "label": "Hardware implementation of various 32-bit and 64-bit multipliers using Bluespec (Report.pdf)", "file_type": "paper", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_shift_and_add_multiplier", "label": "Shift and Add multiplication (plus and adder variants, 1-4 steps/cycle)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null, "rationale": "Plus variants use the built-in + operator; adder variants use an explicit full adder. one/two/three/four names give the number of algorithm iterations done in one cycle."}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_booth_multiplier", "label": "Booth multiplication (iterative and pipelined 32/64-bit)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null, "rationale": "Signed (2's complement) multiplication; pipelined variants group iterations into stages (32-bit: 2x16, 4x8; 64-bit: 4x16, 8x8). Not integrated with the golden model, which handles unsigned products."}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_radix2_multiplier", "label": "Radix-2 multiplication (radix_2.bsv)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null, "rationale": "Groups 2 multiplier bits to select 0, +1 or -1 times multiplicand; cycles reduced to n/8 by doing 8 steps per cycle."}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_radix4_multiplier", "label": "Radix-4 multiplication (radix_4.bsv)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null, "rationale": "Groups 3 multiplier bits to select 0, +-1, +-2 times multiplicand giving n/2 terms; cycles reduced to n/8 by doing 4 steps per cycle."}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_wallace_tree_multiplier", "label": "Wallace tree multiplication (single-cycle, multi-cycle, pipelined)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null, "rationale": "Partial products are grouped in threes and reduced to sum and carry rows until two rows remain, then ripple-added. Pipelined 32-bit version: 3 + (4*7) + 1 = 32 steps."}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_wallace_pipelined", "label": "Pipelined Wallace multiplier (32-bit, variation of multi-cycle)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_wallace_multicycle", "label": "Multi-cycle Wallace multiplier (rl1-rl4, fn_partial/fn_stage/fn_last_stage)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null}, {"id": "c_class_src_obsolete_m_ext_multiplier_designs_report_bluespec_testbench_pattern", "label": "Bluespec random-trial testbench pattern (rule r1 generates, rule r2 compares vs * operator)", "file_type": "rationale", "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "M.K.Sanju Vikasini, K.Sreenidhi", "contributor": null, "rationale": "Each design is checked over m trials by comparing its result against the system's '*' operator; num and num2=2*num constants must be edited in the main BSV file and process_func.bsv."}], "edges": [{"source": "c_class_src_obsolete_m_ext_multiplier_designs_report", "target": "c_class_src_obsolete_m_ext_multiplier_designs_report_shift_and_add_multiplier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "weight": 1.0}, {"source": "c_class_src_obsolete_m_ext_multiplier_designs_report", "target": "c_class_src_obsolete_m_ext_multiplier_designs_report_booth_multiplier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "weight": 1.0}, {"source": "c_class_src_obsolete_m_ext_multiplier_designs_report", "target": "c_class_src_obsolete_m_ext_multiplier_designs_report_radix2_multiplier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "weight": 1.0}, {"source": "c_class_src_obsolete_m_ext_multiplier_designs_report", "target": "c_class_src_obsolete_m_ext_multiplier_designs_report_radix4_multiplier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "c-class/src/obsolete/m_ext/multiplier_designs/Report.pdf", "source_location": null, "wei